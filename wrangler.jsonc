{
  // Cloudflare Workers config. Nitro (cloudflare-module preset) merges this into
  // .output/server/wrangler.json at build time. Secrets are set in the Cloudflare
  // dashboard or with `wrangler secret put`, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anastasia-patience",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
