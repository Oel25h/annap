#!/usr/bin/env bash
# Ralph custom backend adapter → Hermes Agent one-shot.
# Ralph arg mode invokes: <custom_command> -p "<prompt>"
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

PROMPT=""
if [[ "${1:-}" == "-p" || "${1:-}" == "--prompt" ]]; then
  shift
  PROMPT="$*"
elif [[ "${1:-}" == "-q" || "${1:-}" == "--query" ]]; then
  shift
  PROMPT="$*"
else
  PROMPT="$*"
fi

if [[ -z "${PROMPT// }" ]]; then
  echo "hermes-backend: empty prompt" >&2
  exit 2
fi

# Non-interactive Hermes turn in this repo. -Q quiet; --yolo for autonomous tool use in loops.
exec hermes chat -Q --yolo --in "$ROOT" -q "$PROMPT"
