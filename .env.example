# Every environment variable the site reads. Copy to .env for local development
# (scripts/write-local-env.sh writes one for the local Supabase stack).
#
# On Netlify, set these under Site configuration > Environment variables, with
# scope "Functions" (the server function and the scheduled functions read them
# at request time; nothing here is baked into the build). Mark the server-only
# ones as secret. Never put values in netlify.toml.
#
# Third-party keys (Stripe, Resend, YouTube, Gemini, Turnstile) are not
# environment variables: they are entered in the studio (Keys and links) and
# stored encrypted with APP_ENCRYPTION_KEY.

# Public (sent to the browser through the page head)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The canonical address, e.g. https://www.anastasiapatience.com
SITE_URL=

# Server only (secret)
# An sb_secret_ key (SUPABASE_SERVICE_ROLE_KEY is still read as a fallback)
SUPABASE_SECRET_KEY=
ADMIN_SETUP_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Keep it: it decrypts the studio's keys.
APP_ENCRYPTION_KEY=

# Local tests only, ignored unless SITE_URL is localhost: point the APIs at stand-ins.
# STRIPE_API_BASE=
# RESEND_API_BASE=
# GEMINI_API_BASE=
# YOUTUBE_API_BASE=

# Deploying from your machine (bun run deploy:netlify); the Netlify CLI reads these.
# Not needed on Netlify itself.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
